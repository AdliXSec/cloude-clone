# Salin ke .env lalu isi nilainya. JANGAN commit .env.
FLASK_APP=wsgi.py
FLASK_DEBUG=0

# Koneksi database (dipakai app & worker)
DB_HOST=db
DB_PORT=3306
DB_NAME=kosanhub
DB_USER=kosanhub
DB_PASSWORD=ganti-dengan-password-kuat

# Hanya untuk service MySQL di compose.yaml
MYSQL_ROOT_PASSWORD=ganti-dengan-root-password-kuat

# Login admin (dibuat otomatis oleh `flask seed` / `flask create-admin`, tidak menimpa yang sudah ada).
# Kosong = default dev (admin@gmail.com). Untuk production WAJIB diisi password kuat.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Kunci tanda tangan session. Kosong = diturunkan dari DB_PASSWORD. Isi untuk production.
SECRET_KEY="secret-123456"

# Opsional
BILL_DUE_DAY=10
WORKER_POLL_SECONDS=3

# Image app (dipakai hanya di production). Development menggunakan build lokal dari Dockerfile.
# APP_IMAGE=dockeradli/kosanhub:latest
APP_PORT=8000
# 1 = jalankan seeder otomatis saat app start (aman diulang), 0 = matikan
AUTO_SEED=1
