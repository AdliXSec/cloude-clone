// KosanHub CI/CD Pipeline untuk Linux (lokal testing)
// Referensi: Tugas Besar 1 DevOps + Modul Praktikum 1 Jenkins
// Tahap: Checkout → Test → Build → Push → Deploy → Smoke Test

pipeline {
    agent any

    environment {
        // Docker Hub Registry (ganti dockeradli dengan username Docker Hub kamu)
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_IMAGE = 'dockeradli/kosanhub'
        
        // Tag image dengan BUILD_NUMBER (lebih aman daripada latest)
        DOCKER_TAG = "${env.BUILD_NUMBER}"
        DOCKER_TAG_LATEST = 'latest'
        
        // Credentials ID di Jenkins (akan setup manual di Manage Credentials)
        DOCKER_CRED_ID = 'dockerhub-kosanhub'
        
        // Docker Compose
        COMPOSE_PROJECT_NAME = 'kosanhub'
        COMPOSE_FILE_DEV = 'compose.yaml'
        
        // App port lokal (bisa di-override via .env atau parameter)
        APP_PORT = '8000'
        
        // Build metadata
        BUILD_TIME = sh(script: "date -u '+%Y-%m-%dT%H:%M:%SZ'", returnStdout: true).trim()
        GIT_COMMIT_SHORT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
    }

    options {
        // Keep 10 builds terbaru
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '5'))
        // Timeout 45 menit
        timeout(time: 45, unit: 'MINUTES')
        // Disable concurrent builds (aman kalau docker daemon satu)
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "════════════════════════════════════════════════════"
                    echo "STAGE: Checkout dari Git"
                    echo "════════════════════════════════════════════════════"
                    checkout scm
                    
                    echo "✓ Git commit: ${GIT_COMMIT_SHORT}"
                    echo "✓ Branch: ${BRANCH_NAME ?: env.GIT_BRANCH}"
                    
                    // Log environment
                    sh '''
                        echo "Environment validation:"
                        echo "  Docker: $(docker --version)"
                        echo "  Docker Compose: $(docker compose version --short)"
                        echo "  Python: $(python3 --version 2>&1)"
                        echo "  Jenkins user: $(whoami)"
                        echo "  Docker group: $(id -G | tr ' ' '\\n' | xargs -I {} getent group {} | cut -d: -f1 | tr '\\n' ',' | sed 's/,$//')"
                        echo "  Current dir: $(pwd)"
                    '''
                }
            }
        }

        stage('Lint & Security Check') {
            steps {
                script {
                    echo "════════════════════════════════════════════════════"
                    echo "STAGE: Lint Dockerfile & docker-compose"
                    echo "════════════════════════════════════════════════════"
                    sh '''
                        # Validasi syntax docker-compose
                        docker compose -f ${COMPOSE_FILE_DEV} config -q && echo "✓ compose.yaml syntax valid" || exit 1
                        
                        # Cek Dockerfile syntax dasar (pilih optional)
                        echo "✓ Dockerfile review (manual saja, `docker build` akan validate)"
                        
                        # Peringatan: .env harus ada dan tidak di-git
                        if [ -f .env ]; then
                            echo "✓ .env ditemukan (lokal testing)"
                        else
                            echo "⚠ .env tidak ditemukan. Akan menggunakan default dari .env.example"
                            cp .env.example .env.build || cp .env.example .env
                        fi
                        
                        # Cek .gitignore
                        if grep -q "^.env$" .gitignore; then
                            echo "✓ .env di .gitignore"
                        else
                            echo "⚠ .env mungkin tidak di .gitignore - WAJIB fix sebelum production!"
                        fi
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    echo "════════════════════════════════════════════════════"
                    echo "STAGE: Unit Test (pytest)"
                    echo "════════════════════════════════════════════════════"
                    
                    // Build image dengan test stage untuk verification
                    sh '''
                        echo "Building image dengan test stage untuk memverifikasi tes lolos..."
                        # Dockerfile multistage: base → test (gagal jika tes gagal) → production
                        # Dengan COPY --from=test, production tidak bisa dibangun kalau test gagal.
                        
                        docker build \\
                            --target production \\
                            -t ${DOCKER_IMAGE}:test-${BUILD_NUMBER} \\
                            -t ${DOCKER_IMAGE}:test-${GIT_COMMIT_SHORT} \\
                            --build-arg BUILD_NUMBER=${BUILD_NUMBER} \\
                            --build-arg GIT_COMMIT=${GIT_COMMIT_SHORT} \\
                            --build-arg BUILD_TIME="${BUILD_TIME}" \\
                            . || {
                                echo "❌ Build GAGAL - test tidak lolos!"
                                exit 1
                            }
                        
                        echo "✓ Build test image berhasil (test lolos)"
                    '''
                }
            }
        }

        stage('Build Production Image') {
            steps {
                script {
                    echo "════════════════════════════════════════════════════"
                    echo "STAGE: Build Production Image"
                    echo "════════════════════════════════════════════════════"
                    sh '''
                        # Rename tag untuk production
                        docker tag \\
                            ${DOCKER_IMAGE}:test-${BUILD_NUMBER} \\
                            ${DOCKER_IMAGE}:${DOCKER_TAG}
                        
                        docker tag \\
                            ${DOCKER_IMAGE}:test-${BUILD_NUMBER} \\
                            ${DOCKER_IMAGE}:${GIT_COMMIT_SHORT}
                        
                        docker tag \\
                            ${DOCKER_IMAGE}:test-${BUILD_NUMBER} \\
                            ${DOCKER_IMAGE}:${DOCKER_TAG_LATEST}
                        
                        echo "✓ Image tags dibuat:"
                        docker images | grep ${DOCKER_IMAGE} | awk '{print "  " $1":"$2}' | head -5
                    '''
                }
            }
        }

        stage('Push to Docker Hub') {
            when {
                // Push hanya di branch utama atau kalau manual trigger
                anyOf {
                    branch 'main'
                    branch 'master'
                    expression { params.FORCE_PUSH == true }
                }
            }
            steps {
                script {
                    echo "════════════════════════════════════════════════════"
                    echo "STAGE: Push Image ke Docker Hub"
                    echo "════════════════════════════════════════════════════"
                    
                    withCredentials([
                        usernamePassword(
                            credentialsId: "${DOCKER_CRED_ID}",
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASS'
                        )
                    ]) {
                        sh '''
                            # Login ke Docker Hub (aman: credentials dari Jenkins Credentials Store)
                            echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin || {
                                echo "❌ Docker login GAGAL!"
                                exit 1
                            }
                            
                            # Push ketiga tag
                            echo "Pushing ${DOCKER_IMAGE}:${DOCKER_TAG}..."
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                            
                            echo "Pushing ${DOCKER_IMAGE}:${GIT_COMMIT_SHORT}..."
                            docker push ${DOCKER_IMAGE}:${GIT_COMMIT_SHORT}
                            
                            echo "Pushing ${DOCKER_IMAGE}:${DOCKER_TAG_LATEST}..."
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG_LATEST}
                            
                            echo "✓ Image pushed to Docker Hub"
                            
                            # Logout WAJIB untuk keamanan (jangan simpan token di disk)
                            docker logout
                            echo "✓ Logged out dari Docker Hub"
                        '''
                    }
                }
            }
        }

        stage('Deploy (Dev)') {
            steps {
                script {
                    echo "════════════════════════════════════════════════════"
                    echo "STAGE: Deploy ke Lokal (compose.yaml)"
                    echo "════════════════════════════════════════════════════"
                    
                    sh '''
                        echo "Stopping old containers..."
                        docker compose -f ${COMPOSE_FILE_DEV} -p ${COMPOSE_PROJECT_NAME} down -v || true
                        
                        echo "Pulling image baru dari Docker Hub..."
                        docker pull ${DOCKER_IMAGE}:${DOCKER_TAG_LATEST}
                        
                        echo "Menyiapkan environment..."
                        # Gunakan .env lokal (kalau ada), atau gunakan default dari .env.example
                        if [ ! -f .env ]; then
                            echo "Using .env.example as template"
                            cp .env.example .env
                        fi
                        
                        # Override APP_IMAGE untuk gunakan tag baru
                        export APP_IMAGE="${DOCKER_IMAGE}:${DOCKER_TAG_LATEST}"
                        
                        echo "Starting services..."
                        docker compose -f ${COMPOSE_FILE_DEV} -p ${COMPOSE_PROJECT_NAME} up -d
                        
                        sleep 2
                        
                        echo "✓ Docker Compose services started:"
                        docker compose -f ${COMPOSE_FILE_DEV} -p ${COMPOSE_PROJECT_NAME} ps
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    echo "════════════════════════════════════════════════════"
                    echo "STAGE: Smoke Test (Health Check)"
                    echo "════════════════════════════════════════════════════"
                    
                    sh '''
                        HEALTH_URL="http://localhost:${APP_PORT}/health"
                        RETRIES=0
                        MAX_RETRIES=30  # ~30 detik
                        
                        echo "Waiting for app to be ready at ${HEALTH_URL}..."
                        
                        while [ $RETRIES -lt $MAX_RETRIES ]; do
                            HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" "${HEALTH_URL}" 2>/dev/null || echo "000")
                            
                            if [ "$HTTP_STATUS" = "200" ]; then
                                echo "✓ Health check passed (HTTP 200)"
                                RESPONSE=$(curl -s "${HEALTH_URL}")
                                echo "  Response: $RESPONSE"
                                
                                # Test API endpoint (membutuhkan HTTP Basic auth)
                                echo ""
                                echo "Testing API endpoint (jobs list)..."
                                # Gunakan admin@gmail.com:dev (default dari seeder)
                                API_STATUS=$(curl -s -o /dev/null -w "%{http_code}" \\
                                    -u "admin@gmail.com:dev" \\
                                    "http://localhost:${APP_PORT}/api/jobs" 2>/dev/null || echo "000")
                                
                                if [ "$API_STATUS" = "200" ]; then
                                    echo "✓ API /api/jobs accessible (HTTP $API_STATUS)"
                                else
                                    echo "⚠ API /api/jobs returned HTTP $API_STATUS (expected 200)"
                                    echo "   Note: Mungkin default admin belum di-seed. Cek logs."
                                fi
                                
                                echo "✓ Smoke test SUKSES"
                                exit 0
                            fi
                            
                            RETRIES=$((RETRIES + 1))
                            if [ $RETRIES -lt $MAX_RETRIES ]; then
                                echo "  Attempt $RETRIES/$MAX_RETRIES: HTTP $HTTP_STATUS (retrying...)"
                                sleep 1
                            fi
                        done
                        
                        echo "❌ Health check TIMEOUT after ${MAX_RETRIES}s"
                        echo ""
                        echo "Container logs (app):"
                        docker compose -f ${COMPOSE_FILE_DEV} -p ${COMPOSE_PROJECT_NAME} logs app | tail -20
                        exit 1
                    '''
                }
            }
        }

        stage('Post-Deploy Info') {
            steps {
                script {
                    echo "════════════════════════════════════════════════════"
                    echo "STAGE: Deployment Info"
                    echo "════════════════════════════════════════════════════"
                    sh '''
                        echo ""
                        echo "🚀 DEPLOYMENT INFO:"
                        echo "  Web URL: http://localhost:${APP_PORT}/"
                        echo "  Login: admin@gmail.com / dev (default)"
                        echo "  API Base: http://localhost:${APP_PORT}/api"
                        echo "  API Auth: HTTP Basic dengan email/password"
                        echo ""
                        echo "📊 Container status:"
                        docker compose -f ${COMPOSE_FILE_DEV} -p ${COMPOSE_PROJECT_NAME} ps
                        echo ""
                        echo "💾 Database:"
                        docker compose -f ${COMPOSE_FILE_DEV} -p ${COMPOSE_PROJECT_NAME} exec -T db mysqladmin ping || echo "DB not ready yet"
                        echo ""
                        echo "🐳 Image details:"
                        docker inspect ${DOCKER_IMAGE}:${DOCKER_TAG_LATEST} | grep -E '"Created"|"RepoTags"' | head -5
                        echo ""
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                echo ""
                echo "════════════════════════════════════════════════════"
                echo "BUILD SUMMARY"
                echo "════════════════════════════════════════════════════"
                echo "Status: ${currentBuild.result ?: 'IN_PROGRESS'}"
                echo "Build #: ${env.BUILD_NUMBER}"
                echo "Duration: ${currentBuild.durationString}"
                echo "Timestamp: ${BUILD_TIME}"
                echo "Git Commit: ${GIT_COMMIT_SHORT}"
                echo "════════════════════════════════════════════════════"
            }
        }

        success {
            script {
                echo ""
                echo "✅ PIPELINE SUKSES!"
                echo ""
                echo "Langkah berikutnya:"
                echo "  1. Akses http://localhost:${APP_PORT}/"
                echo "  2. Login: admin@gmail.com / dev"
                echo "  3. Cek dashboard, buat kontrak & tagihan"
                echo "  4. Setelah test OK, push ke GitHub (git push origin main)"
                echo "  5. Setup Jenkins di server staging/prod"
                echo ""
            }
        }

        failure {
            script {
                echo ""
                echo "❌ PIPELINE GAGAL"
                echo ""
                echo "Troubleshooting:"
                echo ""
                
                // Cek mana stage yang error
                if (currentBuild.description?.contains('Checkout')) {
                    echo "🔸 Git Checkout: Periksa branch, remote URL, akses"
                } else if (currentBuild.description?.contains('Test')) {
                    echo "🔸 Test Stage: pytest gagal. Cek:"
                    echo "   - requirements-dev.txt"
                    echo "   - tests/ folder"
                    echo "   - Database migration"
                } else if (currentBuild.description?.contains('Build')) {
                    echo "🔸 Build Image: docker build gagal. Periksa:"
                    echo "   - Dockerfile syntax"
                    echo "   - requirements.txt"
                    echo "   - Application entry point"
                } else if (currentBuild.description?.contains('Push')) {
                    echo "🔸 Push: Docker Hub login gagal. Setup:"
                    echo "   - Jenkins Credentials Store"
                    echo "   - Add credential: username/password"
                    echo "   - Credential ID: dockerhub-kosanhub"
                } else if (currentBuild.description?.contains('Deploy')) {
                    echo "🔸 Deploy: Docker Compose gagal. Periksa:"
                    echo "   - .env file (.env.example ada?)"
                    echo "   - compose.yaml valid? (docker compose config -q)"
                    echo "   - Port 8000, 3306 available?"
                } else if (currentBuild.description?.contains('Smoke')) {
                    echo "🔸 Smoke Test: Health check timeout. Debug:"
                    echo "   - docker compose logs app"
                    echo "   - docker compose logs db"
                    echo "   - curl -v http://localhost:8000/health"
                }
                
                echo ""
                echo "Full logs:"
                sh '''
                    echo "Recent container logs (app):"
                    docker compose -f ${COMPOSE_FILE_DEV} -p ${COMPOSE_PROJECT_NAME} logs app 2>/dev/null | tail -50 || echo "Container tidak ada atau sudah stopped"
                '''
            }
        }

        unstable {
            echo "⚠️ Build unstable (ada warnings atau tests yang skip)"
        }

        cleanup {
            script {
                echo ""
                echo "🧹 Cleanup workspace Jenkins..."
                // Jangan hapus workspace dev (untuk debugging), hapus cache saja
                sh '''
                    # Optionally bersihkan old image (keep only last 3 builds)
                    # docker image prune -a -f --filter "until=72h" || true
                    
                    # Jangan remove .env lokal (berguna untuk debugging)
                    # Jangan stop compose (keep running untuk manual testing)
                    
                    echo "✓ Cleanup selesai"
                '''
            }
        }
    }

    parameters {
        booleanParam(name: 'FORCE_PUSH', defaultValue: false, description: 'Force push ke Docker Hub meskipun bukan main branch')
        choice(name: 'LOG_LEVEL', choices: ['INFO', 'DEBUG'], description: 'Log level untuk deployment')
    }
}
